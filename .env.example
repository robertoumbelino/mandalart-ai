# Desenvolvimento: reutiliza o Postgres local (container adstart-database).
# O servidor de desenvolvimento recusa bancos remotos.
DATABASE_URL=postgresql://mandalart:mandalart_local_dev@127.0.0.1:5432/mandalart_local
LOCAL_DATABASE_ONLY=true
# Produção: use a conexão Neon no ambiente do deploy, sem LOCAL_DATABASE_ONLY.

# Gere com: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters

# Client ID de uma credencial OAuth 2.0 do tipo "Aplicativo da Web" no Google Cloud.
# Este identificador é público; não é necessário client secret para o fluxo de ID token.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Modelo servido pelo Vercel AI Gateway.
AI_MODEL_NAME=openai/gpt-5.6-luna

# Apenas para desenvolvimento local fora de `vercel dev`/OIDC.
# AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key

# Compra de sonhos: use exclusivamente chaves de TESTE no desenvolvimento.
# Na Vercel, Production exige uma chave live; Preview e Development recusam live.
APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRICE_ONE=price_replace_me
STRIPE_PRICE_THREE=price_replace_me
STRIPE_PAYMENT_CONFIGURATION=pmc_replace_me
# Opcional: ícone oficial enviado por stripe:setup.
# STRIPE_BRAND_ICON=file_replace_me
# pnpm stripe:listen grava o segredo local automaticamente.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Habilite apenas após liberação do Pix pelo Stripe na conta correspondente.
STRIPE_PIX_ENABLED=false
